# Variable names only. Never commit real values. Local development needs none of
# these set: every default points at a local, synthetic, sandbox setup.

# Local Postgres used by db-reset, tests and the dev gateway (must be localhost).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openseason_local
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Dev gateway (tools/dev-gateway). Random per process when unset.
DEV_GATEWAY_JWT_SECRET=
SANDBOX_WEBHOOK_SECRET=
GATEWAY_PORT=8787
GATEWAY_PUBLIC_URL=http://localhost:8787
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173
# succeeded | failed | uncertain: rehearse refund reconciliation
SANDBOX_REFUND_OUTCOME=succeeded

# Clients
VITE_GATEWAY_URL=http://localhost:8787
# Android emulator: http://10.0.2.2:8787 ; physical device: your machine's LAN address
EXPO_PUBLIC_GATEWAY_URL=http://localhost:8787

# Hosted environments (not wired in this repository yet; server-side secrets live in
# the environment manager, never in clients):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=            (client-safe)
# SUPABASE_SERVICE_ROLE_KEY=    (server only: workers and webhooks)
# PAYMENT_PROVIDER_SECRET_KEY=  (server only)
# PAYMENT_WEBHOOK_SECRET=       (server only)
# MESSAGING_PROVIDER_API_KEY=   (server only: email/SMS/push)
# CONSENT_VERIFICATION_PROVIDER_KEY= (server only: verifiable parental consent)
# AI_PROVIDER_API_KEY=          (server only: staff runtime)
