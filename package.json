{
  "name": "openseason",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:reset": "node scripts/db-reset.mjs",
    "test:db": "pnpm db:reset && pnpm --filter @openseason/db test:db && pnpm db:reset && pnpm --filter @openseason/dev-gateway test:db",
    "dev:gateway": "pnpm --filter @openseason/dev-gateway dev",
    "dev:web": "pnpm --filter @openseason/web dev"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "turbo": "^2.11.10",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  },
  "type": "module"
}
